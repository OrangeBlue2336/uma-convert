 "domains": [
  {
   "id": "chara",
   "table": "chara_data",
   "listColumns": [
    "id",
    "@name",
    "birth_year",
    "birth_month",
    "birth_day",
    "height"
   ],
   "facts": [
    "birth_year",
    "birth_month",
    "birth_day",
    "height",
    "bust",
    "sex",
    "start_date"
   ],
   "sections": [
    {
     "id": "cards",
     "steps": [
      {
       "table": "card_data",
       "match": "chara_id"
      }
     ],
     "columns": [
      "id",
      "@name",
      "default_rarity",
      "limited_chara",
      "running_style",
      "start_date"
     ]
    },
    {
     "id": "supports",
     "steps": [
      {
       "table": "support_card_data",
       "match": "chara_id"
      }
     ],
     "columns": [
      "id",
      "@name",
      "rarity",
      "support_card_type",
      "start_date"
     ]
    }
   ]
  },
  {
   "id": "card",
   "table": "card_data",
   "listColumns": [
    "id",
    "@name",
    "chara_id",
    "default_rarity",
    "running_style",
    "limited_chara",
    "start_date"
   ],
   "facts": [
    "chara_id",
    "default_rarity",
    "limited_chara",
    "running_style",
    "talent_speed",
    "talent_stamina",
    "talent_pow",
    "talent_guts",
    "talent_wiz",
    "start_date"
   ],
   "sections": [
    {
     "id": "rarity",
     "steps": [
      {
       "table": "card_rarity_data",
       "match": "card_id"
      }
     ],
     "columns": [
      "rarity",
      "speed",
      "stamina",
      "pow",
      "guts",
      "wiz",
      "proper_distance_short",
      "proper_distance_mile",
