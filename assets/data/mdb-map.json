      "proper_running_style_nige",
      "proper_running_style_senko",
      "proper_running_style_sashi",
      "proper_running_style_oikomi",
      "proper_ground_turf",
      "proper_ground_dirt"
     ]
    },
    {
     "id": "skills",
     "steps": [
      {
       "table": "available_skill_set",
       "match": "available_skill_set_id",
       "from": "available_skill_set_id"
      }
     ],
     "columns": [
      "skill_id",
      "need_rank"
     ]
    },
    {
     "id": "upgrades",
     "steps": [
      {
       "table": "skill_upgrade_description",
       "match": "card_id"
      }
     ],
     "columns": [
      "rank",
      "skill_id",
      "start_date"
     ]
    }
   ]
  },
  {
   "id": "support",
   "table": "support_card_data",
   "listColumns": [
    "id",
    "@name",
    "chara_id",
    "rarity",
    "support_card_type",
    "start_date"
   ],
   "facts": [
    "chara_id",
    "rarity",
    "support_card_type",
    "command_type",
    "command_id",
    "effect_table_id",
    "unique_effect_id",
    "skill_set_id",
    "start_date"
   ],
   "sections": [
    {
     "id": "effects",
     "steps": [
      {
       "table": "support_card_effect_table",
       "match": "id",
       "from": "effect_table_id"
      }
     ],
     "columns": [
      "type",
      "init",
      "limit_lv5",
      "limit_lv10",
      "limit_lv15",
      "limit_lv20",
      "limit_lv25",
      "limit_lv30",
      "limit_lv35",
      "limit_lv40",
      "limit_lv45",
      "limit_lv50"
     ]
    },
    {
     "id": "unique",
     "steps": [
      {
       "table": "support_card_unique_effect",
       "match": "id",
       "from": "unique_effect_id"
      }
     ],
     "columns": [
      "lv",
      "type_0",
      "value_0",
      "type_1",
      "value_1"
     ]
    },
    {
     "id": "skillset",
     "steps": [
      {
       "table": "skill_set",
       "match": "id",
       "from": "skill_set_id"
      }
     ],
     "layout": "vertical",
     "hideZero": true
    }
   ]
  },
  {
   "id": "skill",
   "table": "skill_data",
   "listColumns": [
    "id",
    "@name",
    "rarity",
    "skill_category",
    "group_id",
    "grade_value",
    "condition_1"
   ],
   "facts": [
    "rarity",
    "group_id",
    "group_rate",
    "skill_category",
    "grade_value",
    "tag_id",
    "activate_lot",
    "priority",
    "unique_skill_id_1",
    "unique_skill_id_2"
   ],
   "sections": [
    {
     "id": "conditions",
     "self": true,
     "layout": "vertical",
     "hideZero": true,
     "columns": [
      "precondition_1",
      "condition_1",
      "float_ability_time_1",
      "float_cooldown_time_1",
      "ability_type_1_1",
      "float_ability_value_1_1",
      "target_type_1_1",
      "ability_type_1_2",
      "float_ability_value_1_2",
      "precondition_2",
      "condition_2",
      "float_ability_time_2",
      "float_cooldown_time_2",
      "ability_type_2_1",
      "float_ability_value_2_1",
      "ability_type_2_2",
      "float_ability_value_2_2"
     ]
    },
    {
     "id": "siblings",
     "steps": [
      {
       "table": "skill_data",
       "match": "group_id",
       "from": "group_id"
      }
     ],
     "columns": [
      "id",
      "@name",
      "rarity",
      "group_rate",
      "grade_value"
     ]
    },
    {
     "id": "holders",
     "steps": [
      {
       "table": "available_skill_set",
       "match": "skill_id",
       "from": "id"
      },
      {
       "table": "card_data",
       "match": "available_skill_set_id",
       "from": "available_skill_set_id"
      }
     ],
     "columns": [
      "id",
      "@name",
      "default_rarity",
      "start_date"
     ]
    },
    {
     "id": "holdersGroup",
     "minus": "holders",
     "hideEmpty": true,
     "steps": [
      {
       "table": "skill_data",
       "match": "group_id",
       "from": "group_id",
       "excludeRoot": true
      },
      {
       "table": "available_skill_set",
       "match": "skill_id",
       "from": "id"
      },
      {
       "table": "card_data",
       "match": "available_skill_set_id",
       "from": "available_skill_set_id"
      }
     ],
     "columns": [
      "id",
      "@name",
      "default_rarity",
      "start_date"
     ]
    },
    {
     "id": "hints",
     "steps": [
      {
       "table": "single_mode_hint_gain",
       "match": "hint_value_1",
       "from": "id",
       "where": {
        "hint_gain_type": 0
       }
      },
      {
       "table": "support_card_data",
       "match": "id",
       "from": "support_card_id"
      }
     ],
     "columns": [
      "id",
      "@name",
      "chara_id",
      "rarity",
      "support_card_type"
     ]
    },
    {
     "id": "hintsGroup",
     "minus": "hints",
     "hideEmpty": true,
     "steps": [
      {
       "table": "skill_data",
       "match": "group_id",
       "from": "group_id",
       "excludeRoot": true
      },
      {
       "table": "single_mode_hint_gain",
       "match": "hint_value_1",
       "from": "id",
       "where": {
        "hint_gain_type": 0
       }
      },
      {
       "table": "support_card_data",
       "match": "id",
       "from": "support_card_id"
      }
     ],
     "columns": [
      "id",
      "@name",
      "chara_id",
      "rarity",
      "support_card_type"
     ]
    },
    {
     "id": "upgrades",
     "steps": [
      {
       "table": "skill_upgrade_description",
       "match": "skill_id"
      }
     ],
     "columns": [
      "card_id",
      "rank",
      "start_date"
     ]
    }
   ]
  },
